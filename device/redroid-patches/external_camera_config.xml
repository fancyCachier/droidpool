<!-- redroid 外接摄像头 HAL 配置。
     画面由宿主灌进 v4l2loopback（RTSP 经 ffmpeg 写入 /dev/videoN），容器
     用 docker 的 device 参数拿到该节点，HAL 把它当成普通 UVC 摄像头。
     参数以 AOSP device/linaro/dragonboard 的样例为基准，按收银机场景收窄：
     只做到 720p，redroid 是软件编解码，再高没有意义只会更卡。
     注意：XML 注释里不能出现连续两个连字符，xmllint 会直接判语法错。 -->
<ExternalCamera>
    <Provider>
        <ignore> <!-- 宿主的编解码节点不是摄像头，别让 HAL 认领 -->
        </ignore>
    </Provider>
    <Device>
        <MaxJpegBufferSize bytes="3145728"/>
        <NumVideoBuffers count="4"/>
        <NumStillBuffers count="2"/>
        <!-- fpsBound 一律给到 30：v4l2loopback 的设备默认就报 30 fps，而设备报的
             fps 一旦超过这里的上限，HAL 会 initCameraCharacteristics 失败并把整个
             设备丢掉（相机数恒为 0，报错却只说 characteristics 失败）。
             把上限压到 15 的话，就必须有人在推流之后到宿主上跑
             v4l2loopback-ctl set-fps —— 而控制面只会 docker，做不到这件事，
             等于给运维留了一个必踩的坑。实际帧率由推流侧的 -r 决定，
             这里只是「允许到多少」。 -->
        <FpsList>
            <Limit width="640" height="480" fpsBound="30.0"/>
            <Limit width="1280" height="720" fpsBound="30.0"/>
        </FpsList>
    </Device>
</ExternalCamera>
