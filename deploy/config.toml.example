# droidpoold 生产配置（devopt .32）。改动后 systemctl restart droidpoold。
listen  = "0.0.0.0:8600"
db_path = "/opt/droidpool/droidpool.db"
# token 放 /opt/droidpool/env（DROIDPOOL_TOKEN=...），不进仓库
token   = "${DROIDPOOL_TOKEN}"

default_ttl   = "4h"
max_ttl       = "24h"
idle_timeout  = "30m"
max_lifetime  = "24h"
reap_interval = "1m"
# 节点可用内存低于此值即拒绝新 claim（实测每台常驻约 1 GB）
min_avail_mib = 2048

# 设备墙 HTTPS 入口。WebCodecs 只在安全上下文（HTTPS / localhost）里存在，
# 用 http://192.168.14.32:8600 打开只有 3 fps 截图流，wall_url 让 http 上的页面自动跳过去。
# 证书由 office-gateway 的 acme.sh 签发（DNS-01）后推到 tls/，换新不用重启，
# 见 docs/2026-09-06-https-cert.md。agent CLI / MCP 仍走 http 8600。
[tls]
listen   = "0.0.0.0:443"
cert     = "/opt/droidpool/tls/fullchain.pem"
key      = "/opt/droidpool/tls/privkey.pem"
wall_url = "https://droidpool.daboshi.cn"

[edge_default]
host = "192.168.14.53"
port = 8090

[[nodes]]
name        = "3588-a"
docker_host = "ssh://sa@192.168.14.54"
adb_host    = "192.168.14.54"
port_range  = [5561, 5576]
# 实测活跃上限 10 台，取 8 留余量给设备墙与人工操作
max_devices = 8
data_root   = "/data/droidpool"
# 1366x768@160 = 收银机实机 Sunmi D1s 2nd；use_memfd 不可省（.54 无 ashmem）
# 公网出口：打开后每台设备多起两个辅助容器（tun 边车 + socks5 中继），
# 公网流量经中继落地、内网（Edge/adb/控制面）始终直连；
# 具体出口地址每台设备在设备墙上单独设，运行中可改且不中断租约。
# 前提：节点上要有 tun 模块（modprobe tun，并写进 /etc/modules-load.d/）。
egress     = false
egress_dns = "223.5.5.5"
# 摄像头：非 0 时每台设备透传 /dev/video<base+序号>（3588-a-1 → /dev/video21）。
# 一台一个节点，共用的话谁先打开谁独占。需要自建镜像（device/redroid-patches）
# 与节点上的 v4l2loopback（deploy/node/setup-node.sh），画面用 rtsp-camera.sh 灌。
camera_video_base = 0
boot_args = "androidboot.use_memfd=true androidboot.use_redroid_overlayfs=1 androidboot.redroid_width=1366 androidboot.redroid_height=768 androidboot.redroid_dpi=160 androidboot.redroid_gpu_mode=guest"
